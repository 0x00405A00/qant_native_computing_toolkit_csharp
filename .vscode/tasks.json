{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-sample",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/samples/Qant.Sample/Qant.Sample.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-blazor",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/samples/Qant.BlazorDemo/Qant.BlazorDemo.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-tests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/tests/Qant.NativeComputing.Tests/Qant.NativeComputing.Tests.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}